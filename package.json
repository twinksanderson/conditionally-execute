{
  "name": "conditionally-execute",
  "description": "Lets you abandon \"if\" keyword",
  "version": "2.0.0",
  "homepage": "https://github.com/bopke/conditionally-execute",
  "author": "Michał Kubik (https://github.com/bopke)",
  "license": "MIT",
  "contributors": [
    "Michał Kubik (https://github.com/bopke)"
  ],
  "repository": "bopke/conditionally-execute",
  "bugs": {
    "url": "https://github.com/bopke/conditionally-execute/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "devDependencies": {
    "eslint": "^9.0.0",
    "mocha": "^10.8.2",
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "mocha test.js",
    "lint": "eslint src test.js bench.js",
    "lint:fix": "eslint src test.js bench.js --fix",
    "bench": "node bench.js"
  },
  "keywords": [
    "if",
    "execution",
    "condition",
    "conditional execution"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
